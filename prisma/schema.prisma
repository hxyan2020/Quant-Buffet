// Local-first SQLite schema for migrating off WordPress
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id              String @id @default(cuid())
  email           String? @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  phone           String? @unique
  passwordHash    String?
  role            String @default("USER")
  libraryUnlocked Boolean   @default(false)

  stripeCustomerId String?

  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  collections   StrategyCollection[]
  backtestRuns  BacktestRun[]
  shopOrders    ShopOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One row per language version of the same quantitative idea
model Strategy {
  id               String  @id @default(cuid())
  slug             String
  locale           String // en | zh
  title            String
  annualisedReturn String?
  sharpeRatio      String?
  region           String?
  market           String?
  assetClass       String?
  frequency        String?
  teaser           String  @default("")
  summary          String  @default("")
  contentHtml      String  @default("")
  backtestMetrics  String  @default("{}")
  volatility       String?
  beta             String?
  sortinoRatio     String?
  maxDrawdown      String?
  winRate          String?
  isPaywalled      Boolean @default(true)
  hasPythonCode    Boolean @default(false)
  paperTitle         String?
  paperAuthors       String?
  paperInstitute       String  @default("N/A")
  paperAffiliationsJson String @default("[]")
  academicLink       String?
  /// JSON array of { src, alt } paper screenshots restored from WordPress
  paperImagesJson    String  @default("[]")
  economicRationale  String  @default("")
  pythonCodeHtml     String  @default("")
  metaTitle        String?
  metaDescription  String?
  sortOrder        Int     @default(0)
  published        Boolean @default(true)
  /// Retired from public library; kept intact for admin. Not deleted.
  archived         Boolean @default(false)
  /// Last content save: human | ai
  lastEditedBy     String  @default("human")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections StrategyCollection[]

  @@unique([slug, locale, archived])
  @@index([locale])
  @@index([published])
  @@index([archived])
}

/// User bookmarked / collected strategies
model StrategyCollection {
  id         String   @id @default(cuid())
  userId     String
  strategyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([userId, strategyId])
  @@index([userId])
}

/// One interactive backtest execution by a signed-in user (usage metering).
model BacktestRun {
  id               String   @id @default(cuid())
  userId           String
  strategySlug     String
  strategyLocale   String   @default("en")
  strategyTitle    String   @default("")
  source           String   @default("live") // live | lab
  status           String   @default("ok") // ok | error
  errorType        String?
  errorLine        Int?
  /// Simulated ("dummy") fills placed by the engine during this run.
  trades           Int      @default(0)
  assetsJson       String   @default("[]")
  periodStart      String?
  periodEnd        String?
  annualisedReturn String?
  sharpeRatio      String?
  maxDrawdown      String?
  durationMs       Int      @default(0)
  /// UTC calendar day (YYYY-MM-DD) so heatmaps can group without date math.
  runDate          String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, runDate])
  @@index([userId, createdAt])
  @@index([strategySlug])
}

model Subscription {
  id                    String    @id @default(cuid())
  userId                String
  stripeCustomerId      String?
  stripeCheckoutSession String?
  stripePaymentIntentId String?
  status                String    @default("active")
  tier                  String    @default("full-library")
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Physical / shop catalog item (distinct from library membership plans).
model Product {
  id              String  @id @default(cuid())
  slug            String  @unique
  nameEn          String
  nameZh          String
  descriptionEn   String  @default("")
  descriptionZh   String  @default("")
  specPromptEn    String  @default("")
  specPromptZh    String  @default("")
  unitAmount      Int
  currency        String  @default("usd")
  stripeProductId String?
  stripePriceId   String?
  isDummy         Boolean @default(false)
  published       Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders ShopOrder[]
}

/// One customer purchase of a catalog product.
model ShopOrder {
  id                      String    @id @default(cuid())
  orderNumber             String    @unique
  userId                  String
  productId               String
  quantity                Int       @default(1)
  /// Customer-keyed specifications shown to admin when preparing the order.
  preference              String
  unitAmount              Int
  currency                String    @default("usd")
  status                  String    @default("pending_payment")
  stripeCheckoutSession   String?   @unique
  stripePaymentIntentId   String?
  stripeCustomerId        String?
  customerEmail           String?
  shippingNumber          String?
  shippingCarrier         String?
  shippedAt               DateTime?
  confirmationEmailSentAt DateTime?
  shippingEmailSentAt     DateTime?
  locale                  String    @default("en")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
  @@index([orderNumber])
}
